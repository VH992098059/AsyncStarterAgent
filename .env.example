APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://starter:starter@localhost:5432/starter?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# 决策 #2：JWT 签发密钥（HS256）。生产环境必须 ≥ 32 字节随机串；开发可保留示例值。
JWT_SECRET=change-me-in-production-min-32-bytes-random
TODOIST_WEBHOOK_SECRET=
LOG_LEVEL=info
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
