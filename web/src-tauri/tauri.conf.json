{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AsyncStarter",
  "version": "0.1.0",
  "identifier": "com.asyncstarter.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AsyncStarterAgent",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:*; style-src 'self' 'unsafe-inline'"
    }
  }
}
